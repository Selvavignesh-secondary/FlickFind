# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL + pgvector Database URL
DATABASE_URL=postgresql://flickadmin:flicksecretpassword@127.0.0.1:5433/flickfind_db

# Optional: Set to 'true' if you wish to use Gemini Embedding API instead of local Nomic model
USE_GEMINI_EMBEDDINGS=false
